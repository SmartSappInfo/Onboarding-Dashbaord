// Deployment fix for organizations list permission
rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {
    // --- Helper Functions ---
    function isSignedIn() {
      return request.auth != null;
    }

    function getUserData() {
      let path = /databases/$(database)/documents/users/$(request.auth.uid);
      return exists(path) ? get(path).data : null;
    }

    function isAuthorized() {
      return isSignedIn() && (
        request.auth.token.email == 'admin@smartsapp.com' ||
        (getUserData() != null && getUserData().get('isAuthorized', false) == true)
      );
    }

    function isSystemAdmin() {
      let data = getUserData();
      return isSignedIn() && (
        request.auth.token.email == 'admin@smartsapp.com' ||
        (data != null && data.get('isAuthorized', false) == true && 
         data.get('permissions', []).hasAny(['system_admin']))
      );
    }

    function isOrgMatch(orgId) {
      let data = getUserData();
      return isSignedIn() && (
        request.auth.token.email == 'admin@smartsapp.com' ||
        (data != null && data.get('organizationId', '') == orgId)
      );
    }

    function hasPermission(perm) {
      let data = getUserData();
      return isSignedIn() && (
        request.auth.token.email == 'admin@smartsapp.com' ||
        (data != null && data.get('isAuthorized', false) == true && 
         (data.get('permissions', []).hasAny([perm]) || data.get('permissions', []).hasAny(['system_admin'])))
      );
    }

    function canAccessWorkspace(targetWorkspaceIds) {
      let data = getUserData();
      return isSignedIn() && (
        request.auth.token.email == 'admin@smartsapp.com' ||
        (data != null && data.get('isAuthorized', false) == true && 
         (data.get('permissions', []).hasAny(['system_admin']) || 
          data.get('workspaceIds', []).hasAny(targetWorkspaceIds)))
      );
    }

    // Industry-specific helper function
    // Requirement 10.9: Validate collection access based on Workspace Industry_Vertical
    // Requirement 16.8: Gate read/write on hasWorkspaceAccess AND workspaceIndustryMatches
    function workspaceIndustryMatches(workspaceId, requiredIndustry) {
      let workspacePath = /databases/$(database)/documents/workspaces/$(workspaceId);
      return exists(workspacePath) && get(workspacePath).data.industry == requiredIndustry;
    }

    function hasWorkspaceAccess(workspaceId) {
      let data = getUserData();
      return isSignedIn() && (
        request.auth.token.email == 'admin@smartsapp.com' ||
        (data != null && data.get('isAuthorized', false) == true && 
         (data.get('permissions', []).hasAny(['system_admin']) || 
          workspaceId in data.get('workspaceIds', [])))
      );
    }

    /**
     * True when the caller can access ANY of the given workspace ids. Used for
     * documents shared across several workspaces (e.g. message templates), where
     * membership of one shared workspace is enough to read the document.
     */
    function hasAnyWorkspaceIn(wsIds) {
      let data = getUserData();
      return isSignedIn() && (
        request.auth.token.email == 'admin@smartsapp.com' ||
        (data != null && data.get('isAuthorized', false) == true &&
         (data.get('permissions', []).hasAny(['system_admin']) ||
          wsIds.hasAny(data.get('workspaceIds', []))))
      );
    }

    // --- Base Deny-All ---
    match /{document=**} {
      allow read, write: if false;
    }

    // --- System Settings (Server/Admin SDK only, except safe configurations) ---
    match /system_settings/ai_config {
      allow read: if isSignedIn();
      allow write: if isSystemAdmin();
    }

    match /system_settings/templates {
      allow read: if isAuthorized();
      allow write: if isSystemAdmin();
    }

    match /system_settings/industries_lifecycle {
      allow read: if isAuthorized();
      allow write: if isSystemAdmin();
    }

    match /system_settings/lead_scoring {
      allow read: if isAuthorized();
      allow write: if isSystemAdmin();
    }

    match /learning_signals/{signalId} {
      allow read, write: if false;
    }

    match /system_settings/{settingId} {
      allow read, write: if false;
    }

    // --- Platform Control Plane (Backoffice) — server/Admin SDK only ---
    // All access flows through backoffice server actions that verify the
    // caller's ID token and enforce RBAC (see backoffice-auth.ts). The Admin
    // SDK bypasses these rules; denying the client SDK here is defense-in-depth
    // and guarantees platform_audit_logs immutability.
    match /platform_features/{id}              { allow read, write: if false; }
    match /platform_entitlements/{id}          { allow read, write: if false; }
    match /platform_templates/{id}             { allow read, write: if false; }
    match /platform_assets/{id}                { allow read, write: if false; }
    match /platform_provider_settings/{id}     { allow read, write: if false; }
    match /platform_field_defaults/{id}        { allow read, write: if false; }
    match /platform_native_fields/{id}         { allow read, write: if false; }
    match /platform_contact_type_defaults/{id} { allow read, write: if false; }
    match /platform_industry_field_groups/{id} { allow read, write: if false; }
    match /platform_jobs/{id}                  { allow read, write: if false; }
    // Audit logs: never client-readable, never mutable (immutability).
    match /platform_audit_logs/{id}            { allow read, write: if false; }
    // Governance: approval queue is server-only (four-eyes enforced in actions).
    match /platform_approval_requests/{id}     { allow read, write: if false; }
    // Operations & Telemetry: zero-trust server control plane
    match /tenant_issues/{id}                  { allow read, write: if false; }
    match /webhook_dead_letters/{id}           { allow read, write: if false; }
    match /suppression_list/{id}               { allow read, write: if false; }

    // --- Shared Reference Data ---
    match /countries/{countryId} {
      allow read: if isAuthorized();
      allow write: if isAuthorized() && isSystemAdmin();
    }

    match /regions/{regionId} {
      allow read: if isAuthorized() && (
        isSystemAdmin() || 
        !('organizationId' in resource.data) || 
        resource.data.organizationId == null || 
        isOrgMatch(resource.data.organizationId)
      );
      allow write: if isAuthorized() && (isSystemAdmin() || isOrgMatch(request.resource.data.organizationId));
    }

    match /districts/{districtId} {
      allow read: if isAuthorized() && (
        isSystemAdmin() || 
        !('organizationId' in resource.data) || 
        resource.data.organizationId == null || 
        isOrgMatch(resource.data.organizationId)
      );
      allow write: if isAuthorized() && (isSystemAdmin() || isOrgMatch(request.resource.data.organizationId));
    }

    match /modules/{moduleId} {
      allow read: if isAuthorized();
      allow write: if isAuthorized() && isSystemAdmin();
    }

    // --- Governance Layer (Org Bound) ---
    match /organizations/{orgId} {
      allow read: if isSignedIn() && (isSystemAdmin() || isOrgMatch(orgId));
      allow write: if isSystemAdmin();
    }

    match /users/{userId} {
      // A signed-in user may always read their OWN profile — required for the
      // onboarding wizard and guards before they are authorized/approved.
      allow get: if isSignedIn() && (request.auth.uid == userId || isSystemAdmin() || isAuthorized());
      allow list: if isSignedIn() && (isSystemAdmin() || isAuthorized());
      allow update: if isSignedIn() && isSystemAdmin();
      allow create: if isSignedIn() && request.auth.uid == userId;
    }

    // --- Identity & Membership 2.0 Collections ---
    match /accounts/{accountId} {
      allow get: if isSignedIn() && (request.auth.uid == accountId || isSystemAdmin());
      allow list, write: if false;
    }

    match /people/{personId} {
      allow get: if isSignedIn() && (request.auth.uid == personId || isSystemAdmin() || (isAuthorized() && isOrgMatch(resource.data.organizationId)));
      allow list: if isSignedIn() && (isSystemAdmin() || isAuthorized());
      allow write: if false;
    }

    match /organization_memberships/{membershipId} {
      allow get: if isSignedIn() && (isSystemAdmin() || (isAuthorized() && isOrgMatch(resource.data.organizationId)));
      allow list: if isSignedIn() && (isSystemAdmin() || isAuthorized());
      allow write: if false;
    }

    match /workspace_memberships/{membershipId} {
      allow get: if isSignedIn() && (isSystemAdmin() || (isAuthorized() && isOrgMatch(resource.data.organizationId)));
      allow list: if isSignedIn() && (isSystemAdmin() || isAuthorized());
      allow write: if false;
    }

    match /roles/{roleId} {
      allow get: if isAuthorized() && (isSystemAdmin() || isOrgMatch(resource.data.organizationId));
      allow list: if isAuthorized() && (isSystemAdmin() || isOrgMatch(resource.data.organizationId));
      allow create: if isAuthorized() && (
        isSystemAdmin() || 
        (isOrgMatch(request.resource.data.organizationId) && (hasPermission('users_manage') || hasPermission('management_users')))
      );
      allow update: if isAuthorized() && (
        isSystemAdmin() || 
        (isOrgMatch(resource.data.organizationId) && 
         request.resource.data.organizationId == resource.data.organizationId &&
         (hasPermission('users_manage') || hasPermission('management_users')))
      );
      allow delete: if isAuthorized() && (
        isSystemAdmin() || 
        (isOrgMatch(resource.data.organizationId) && (hasPermission('users_manage') || hasPermission('management_users')))
      );
    }

    match /billing_profiles/{profileId} {
      allow get: if isAuthorized() && (isSystemAdmin() || canAccessWorkspace(resource.data.workspaceIds) || isOrgMatch(resource.data.organizationId));
      allow list: if isSystemAdmin() || (isAuthorized() && canAccessWorkspace(resource.data.workspaceIds));
      allow create, update: if isAuthorized() && (isSystemAdmin() || (hasPermission('finance_manage') && (canAccessWorkspace(request.resource.data.workspaceIds) || isOrgMatch(request.resource.data.organizationId))));
      allow delete: if isAuthorized() && (isSystemAdmin() || (hasPermission('finance_manage') && (canAccessWorkspace(resource.data.workspaceIds) || isOrgMatch(resource.data.organizationId))));
    }

    match /verification_cache/{docId} {
      allow read: if isAuthorized();
    }

    match /phone_verification_cache/{docId} {
      allow read: if isAuthorized();
      // Writes are admin-SDK only (server-side verification), never from clients.
    }

    match /workspaces/{workspaceId} {
      allow get: if isAuthorized() && (isSystemAdmin() || isOrgMatch(resource.data.organizationId));
      allow list: if isSignedIn() && (request.auth.token.email == 'admin@smartsapp.com' || isAuthorized());
      allow write: if isAuthorized() && (request.auth.token.email == 'admin@smartsapp.com' || isSystemAdmin());
    }

    // --- Operational Layer (Workspace Shared Array) ---
    match /schools/{schoolId} {
      allow get: if isAuthorized() && (isSystemAdmin() || canAccessWorkspace(resource.data.workspaceIds));
      allow list: if isAuthorized();
      allow create: if isAuthorized();
      allow update: if isAuthorized() && (
        isSystemAdmin() ||
        canAccessWorkspace(resource.data.workspaceIds) ||
        // Allow tag-only updates with schools_edit permission
        (hasPermission('schools_edit') &&
         canAccessWorkspace(resource.data.workspaceIds) &&
         request.resource.data.diff(resource.data).affectedKeys().hasOnly(['tags', 'taggedAt', 'taggedBy']))
      );
      allow delete: if isAuthorized() && hasPermission('system_admin') && canAccessWorkspace(resource.data.workspaceIds);
    }

    match /pipelines/{pId} {
      allow get: if isSystemAdmin() || (isAuthorized() && canAccessWorkspace(resource.data.workspaceIds));
      allow list: if isAuthorized();
      allow write: if isAuthorized() && hasPermission('system_admin') && canAccessWorkspace(request.resource.data.workspaceIds);
    }

    match /onboardingStages/{stageId} {
      allow get: if isAuthorized();
      allow list: if isAuthorized();
      allow create: if isAuthorized() && (
        isSystemAdmin() ||
        canAccessWorkspace(get(/databases/$(database)/documents/pipelines/$(request.resource.data.pipelineId)).data.workspaceIds)
      );
      allow update: if isAuthorized() && (
        isSystemAdmin() ||
        (canAccessWorkspace(get(/databases/$(database)/documents/pipelines/$(resource.data.pipelineId)).data.workspaceIds) &&
         request.resource.data.pipelineId == resource.data.pipelineId)
      );
      allow delete: if isAuthorized() && (
        isSystemAdmin() ||
        canAccessWorkspace(get(/databases/$(database)/documents/pipelines/$(resource.data.pipelineId)).data.workspaceIds)
      );
    }

    match /deals/{dealId} {
      allow get, list: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(resource.data.workspaceId)
      );
      allow create: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(request.resource.data.workspaceId)
      );
      allow update: if isAuthorized() && (
        isSystemAdmin() || 
        (hasWorkspaceAccess(resource.data.workspaceId) && 
         request.resource.data.workspaceId == resource.data.workspaceId)
      );
      allow delete: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(resource.data.workspaceId)
      );
    }

    match /deal_quotes/{quoteId} {
      allow get: if true;
      allow list: if isAuthorized();
      allow create: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(request.resource.data.workspaceId)
      );
      allow update, delete: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(resource.data.workspaceId)
      );
    }

    // --- Product Catalog, Categories & Price Books (Phase 4) ---
    match /products/{productId} {
      allow read: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(resource.data.workspaceId)
      );
      allow create: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(request.resource.data.workspaceId)
      );
      allow update, delete: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(resource.data.workspaceId)
      );
    }

    match /product_categories/{categoryId} {
      allow read: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(resource.data.workspaceId)
      );
      allow create: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(request.resource.data.workspaceId)
      );
      allow update, delete: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(resource.data.workspaceId)
      );
    }

    match /price_books/{priceBookId} {
      allow read: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(resource.data.workspaceId)
      );
      allow create: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(request.resource.data.workspaceId)
      );
      allow update, delete: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(resource.data.workspaceId)
      );
    }

    match /price_book_items/{itemId} {
      allow read, write: if isAuthorized();
    }

    // --- Phase 5 Automation Engine & Dead-Letter Queue ---
    match /automation_dead_letters/{dlqId} {
      allow read, write: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(resource.data.workspaceId)
      );
    }

    match /deal_bulk_jobs/{jobId} {
      allow read, write: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(resource.data.workspaceId)
      );
    }

    // --- Phase 6 Saved Views & Intelligent Filters ---
    match /deal_saved_views/{viewId} {
      allow read: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(resource.data.workspaceId)
      );
      allow create: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(request.resource.data.workspaceId)
      );
      allow update, delete: if isAuthorized() && (
        isSystemAdmin() || 
        (hasWorkspaceAccess(resource.data.workspaceId) && 
         (resource.data.userId == request.auth.uid || resource.data.isShared == true))
      );
    }

    // --- Phase 7 Forecasting & Quota Targets ---
    match /pipeline_targets/{targetId} {
      allow read: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(resource.data.workspaceId)
      );
      allow create: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(request.resource.data.workspaceId)
      );
      allow update, delete: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(resource.data.workspaceId)
      );
    }

    match /automation_idempotency_keys/{keyId} {
      allow read, write: if isAuthorized();
    }

    match /meetings/{meetingId} {
      allow read: if true; 
      allow create: if isAuthorized();
      allow list: if isAuthorized();
      allow update, delete: if isAuthorized() && (isSystemAdmin() || canAccessWorkspace(resource.data.workspaceIds));
      
      match /attendees/{aId} {
        allow create: if true;
        allow read, list: if isAuthorized();
      }

      match /registrants/{rId} {
        allow create: if true;
        allow read, list, update: if isAuthorized();
      }

      match /participants/{pId} {
        allow read: if true;
        allow list, write: if isAuthorized();
      }

      match /registrations/{regId} {
        allow read: if true;
        allow list, write: if isAuthorized();
      }
    }

    match /conference_sessions/{sessionId} {
      allow get: if true;
      allow list, write: if isAuthorized();
    }

    match /meeting_activities/{activityId} {
      allow read, list: if isAuthorized();
      allow write: if isAuthorized();
    }

    // Booking Pages & Calendars Scheduling Engine Rules (Meetings 2.0)
    match /event_types/{eventTypeId} {
      allow get: if true;
      allow list: if isAuthorized();
      allow create: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
      allow update, delete: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
    }

    match /availability_profiles/{profileId} {
      allow get: if true;
      allow list: if isAuthorized();
      allow create: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
      allow update, delete: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
    }

    match /scheduling_profiles/{profileId} {
      allow get: if true;
      allow list: if isAuthorized();
      allow create: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
      allow update, delete: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
    }

    match /booking_pages/{pageId} {
      allow read: if true;
      allow create: if isAuthorized();
      allow update, delete: if isAuthorized() && (isSystemAdmin() || canAccessWorkspace(resource.data.workspaceIds));
    }
    
    match /bookings/{bookingId} {
      allow get: if true;
      allow list: if isAuthorized();
      allow create: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
      allow update, delete: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
    }

    match /booking_holds/{holdId} {
      // Locking and hold management are exclusively executed via backend server actions (Admin SDK)
      allow read, write: if false;
    }

    match /calendar_connections/{connId} {
      allow list, get: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
      // Mutation is strictly via server actions
      allow write: if false;
    }

    match /routing_forms/{formId} {
      allow get: if true;
      allow list: if isAuthorized();
      allow create: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
      allow update, delete: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
    }

    match /routing_submissions/{subId} {
      // Submissions and qualification history are server-managed
      allow read, write: if false;
    }

    match /meeting_recordings/{recId} {
      allow list, get: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
      allow write: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
    }

    match /meeting_transcripts/{transcriptId} {
      allow list, get: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
      allow write: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
    }

    match /meeting_intelligence/{intelId} {
      allow list, get: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
      allow write: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
    }

    match /recurring_series/{seriesId} {
      allow list, get: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
      allow write: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
    }

    match /meeting_polls/{pollId} {
      allow get: if true;
      allow list: if isAuthorized();
      allow create, update: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
      allow delete: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));

      match /votes/{voteId} {
        allow create, update, get: if true;
        allow list, delete: if isAuthorized();
      }
    }

    match /office_hours_rooms/{roomId} {
      allow get: if true;
      allow list: if isAuthorized();
      allow write: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
    }

    match /office_hours_queue/{entryId} {
      allow get, create, update: if true;
      allow list, delete: if isAuthorized();
    }

    match /meeting_workflows/{ruleId} {
      allow list, get: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
      allow write: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
    }

    match /meeting_webhooks/{webhookId} {
      allow list, get: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
      allow write: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
    }

    match /webhook_delivery_logs/{logId} {
      allow list, get: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
      allow write: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
    }

    match /meeting_deal_attributions/{attributionId} {
      allow list, get: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
      allow write: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
    }

    match /webinar_questions/{questionId} {
      allow read, create, update: if true;
      allow delete: if isAuthorized();
    }

    match /meeting_feedback/{feedbackId} {
      allow create, get: if true;
      allow list: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
      allow write: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
    }

    match /meeting_resources/{resId} {
      allow read: if true;
      allow write: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
    }

    match /resource_reservations/{resId} {
      allow read: if true;
      allow write: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
    }

    match /payment_transactions/{txId} {
      allow read: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
      allow write: if false; // Server-side writes only via Admin SDK & Server Actions
    }

    match /meeting_compliance_policies/{policyId} {
      allow read: if true;
      allow write: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
    }

    match /meeting_action_items/{itemId} {
      allow list, get: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
      allow write: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
    }

    match /meeting_reminder_jobs/{jobId} {
      allow list, get: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
      allow write: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
    }

    match /meeting_telemetry_logs/{logId} {
      allow create: if true;
      allow list, get: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
    }

    match /series_instance_overrides/{overrideId} {
      allow read: if true;
      allow write: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
    }

    match /meeting_speech_coaching/{coachingId} {
      allow list, get: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
      allow write: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
    }

    match /meeting_templates/{templateId} {
      allow read: if true;
      allow write: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
    }

    match /user_availabilities/{availId} {
      allow read: if true;
      allow write: if isAuthorized() && (isSystemAdmin() || canAccessWorkspace(resource.data.workspaceIds));
