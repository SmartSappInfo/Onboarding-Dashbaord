      allow write: if isAuthorized();
    }

    match /flipbook_leads/{leadId} {
      allow create: if true;
      allow read, list, update, delete: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
    }

    match /flipbook_analytics/{eventId} {
      allow create: if true;
      allow read, list: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
    }

    match /media/{mediaId} {
      allow get: if true; // Public access for reading shared, embedded, or public media assets
      allow list: if isSignedIn() && (request.auth.token.email == 'admin@smartsapp.com' || isAuthorized());
      allow create: if isAuthorized();
      allow update, delete: if isAuthorized() && (isSystemAdmin() || canAccessWorkspace(resource.data.workspaceIds));
    }

    match /media_shares/{shareId} {
      allow get: if true; // Public access for reading shared media pages
      allow list: if isAuthorized();
      allow create: if isAuthorized() && hasWorkspaceAccess(request.resource.data.workspaceId);
      allow update, delete: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
    }

    match /media_categories/{categoryId} {
      allow get: if true; // Public access for reading category details on shared media
      allow list: if isSignedIn() && (request.auth.token.email == 'admin@smartsapp.com' || isAuthorized());
      allow create: if isAuthorized();
      allow update, delete: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
    }

    match /thumbnail_designs/{designId} {
      allow get: if true; // Public access for rendering thumbnail designs on shared media
      allow list: if isSignedIn() && (request.auth.token.email == 'admin@smartsapp.com' || isAuthorized());
      allow create: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId));
      allow update, delete: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(resource.data.workspaceId));
    }

    // --- Creative Studio 2.0 Collections ---
    match /creative_projects/{projectId} {
      allow get: if true; // Public access for linked shared project previews
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /creative_documents/{documentId} {
      allow get: if true; // Public access for rendering canvas preview
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /creative_assets/{assetId} {
      allow get: if true; // Public access for preview URLs
      allow list: if isSignedIn();
      allow create: if isSignedIn();
      allow update, delete: if isSignedIn();
    }

    match /creative_brand_kits/{kitId} {
      allow get: if true;
      allow list: if isSignedIn();
