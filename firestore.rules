      allow update, delete: if isSignedIn();
    }

    match /creative_comments/{commentId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /creative_versions/{versionId} {
      allow get, list: if isSignedIn();
      allow create, update, delete: if isSignedIn();
    }

    match /creative_templates/{templateId} {
      allow get, list: if true;
      allow create, update, delete: if isSignedIn();
    }

    match /creative_shares/{shareId} {
      allow get: if true; // Public access for client preview links
      allow list, create, update, delete: if isSignedIn();
    }

    match /creative_concepts/{conceptId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    match /creative_ai_logs/{logId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    match /creative_reviews/{reviewId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    match /creative_presence/{presenceId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    match /creative_publications/{pubId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    match /creative_channels/{channelId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    match /creative_experiments/{expId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    match /creative_analytics/{analyticId} {
      allow get, list, create, update, delete: if isSignedIn();
    }

    // --- Message Templates (Two-Tier System) ---
    // Task 16.1: Security rules for message_templates collection
    // Global templates: read by all authenticated users, write only by super admins
    // Org templates: read/write scoped to matching organizationId
    match /message_templates/{tId} {
      // Read access is tenant-scoped: a template is readable when it is a global
      // blueprint, belongs to the caller's organization, or is shared with a
      // workspace the caller can access. System admins read everything.
      //
      // NOTE: Firestore evaluates `list` per returned document, so every client
      // query must be scoped (by workspaceIds, organizationId or scope=='global')
      // or it will be rejected outright. All known callers are scoped accordingly.
      allow read: if isAuthorized() && (
        isSystemAdmin() ||
        resource.data.get('scope', '') == 'global' ||
        isOrgMatch(resource.data.get('organizationId', '')) ||
        hasAnyWorkspaceIn(resource.data.get('workspaceIds', []))
      );
      
      // Write access for global templates: super admins only
      allow create: if isAuthorized() && (
        (request.resource.data.scope == 'global' && isSystemAdmin()) ||
        (request.resource.data.get('scope', 'organization') in ['organization', 'workspace'] && 
         hasPermission('studios_edit') && 
         isOrgMatch(request.resource.data.organizationId))
      );
      
      allow update: if isAuthorized() && (
        (resource.data.scope == 'global' && isSystemAdmin()) ||
        (resource.data.get('scope', 'organization') in ['organization', 'workspace'] && 
         hasPermission('studios_edit') && 
         isOrgMatch(resource.data.organizationId) &&
         // Prevent organizationId changes
         request.resource.data.organizationId == resource.data.organizationId)
      );
      
      allow delete: if isAuthorized() && (
        (resource.data.scope == 'global' && isSystemAdmin()) ||
        (resource.data.get('scope', 'organization') in ['organization', 'workspace'] && 
         hasPermission('studios_edit') && 
         isOrgMatch(resource.data.organizationId))
      );
    }

    // --- Template Variables Registry ---
    // Task 16.2: Security rules for template_variables collection
    // Read: all authenticated users (needed for template editor and composer)
    // Write: super admins and org admins (for dynamic form/survey variable registration)
    match /template_variables/{varId} {
      // Read access: all authenticated users can read variables
      allow get, list: if isAuthorized();
      
      // Write access: super admins can write all variables
      // Org admins can write variables scoped to their organization
      allow create: if isAuthorized() && (
        isSystemAdmin() ||
        (hasPermission('studios_edit') && 
         (!request.resource.data.keys().hasAny(['organizationId']) || 
          isOrgMatch(request.resource.data.organizationId)))
      );
      
      allow update: if isAuthorized() && (
        isSystemAdmin() ||
        (hasPermission('studios_edit') && 
         (!resource.data.keys().hasAny(['organizationId']) || 
          isOrgMatch(resource.data.organizationId)))
      );
      
      allow delete: if isAuthorized() && (
        isSystemAdmin() ||
        (hasPermission('studios_edit') && 
         (!resource.data.keys().hasAny(['organizationId']) || 
          isOrgMatch(resource.data.organizationId)))
      );
    }

    // --- Scheduled Messages (Reminder System) ---
    // Task 16.3: Security rules for scheduled_messages collection
    // Read/write scoped to organizationId
    match /scheduled_messages/{msgId} {
      // Read access: users in matching organization
      allow get: if isAuthorized() && (
        isSystemAdmin() ||
        isOrgMatch(resource.data.organizationId)
      );
      
      // List access: all authorized users (filtering by org happens in queries)
      allow list: if isAuthorized();
      
      // Create: users in matching organization with appropriate permissions
      allow create: if isAuthorized() && (
        isSystemAdmin() ||
        isOrgMatch(request.resource.data.organizationId)
      );
      
      // Update: users in matching organization
      // Prevent organizationId changes
      allow update: if isAuthorized() && (
        isSystemAdmin() ||
        (isOrgMatch(resource.data.organizationId) &&
         request.resource.data.organizationId == resource.data.organizationId)
      );
      
      // Delete: super admins or users in matching organization
      allow delete: if isAuthorized() && (
        isSystemAdmin() ||
        isOrgMatch(resource.data.organizationId)
      );
    }

    match /sender_profiles/{pId} {
      // Read stays open to authorized users; org/workspace filtering happens in queries.
      allow read: if isAuthorized();

      // A profile may only be created for the writer's OWN organization, and only
      // in a workspace they can access. organizationId is the tenant owner.
      allow create: if isAuthorized() && hasPermission('studios_edit')
                    && isOrgMatch(request.resource.data.organizationId)
                    && canAccessWorkspace(request.resource.data.workspaceIds);

      // Updates stay within the same org; organizationId is immutable so a profile
      // can never be re-homed into another tenant.
      allow update: if isAuthorized() && hasPermission('studios_edit')
                    && isOrgMatch(resource.data.organizationId)
                    && request.resource.data.organizationId == resource.data.organizationId
                    && canAccessWorkspace(request.resource.data.workspaceIds);

      allow delete: if isAuthorized() && hasPermission('studios_edit')
                    && isOrgMatch(resource.data.organizationId);
    }

    match /message_styles/{sId} {
      // Allow read for all authorized users - workspace/org filtering happens in queries
      allow read: if isAuthorized();
      allow write: if isAuthorized() && (
        isSystemAdmin() ||
        (
          request.method != 'delete' &&
          (!request.resource.data.keys().hasAll(['scope']) || request.resource.data.scope != 'global') &&
          (resource == null || !resource.data.keys().hasAll(['scope']) || resource.data.scope != 'global') &&
          hasPermission('studios_edit') &&
          (canAccessWorkspace(request.resource.data.workspaceIds) || (request.resource.data.keys().hasAll(['organizationId']) && isOrgMatch(request.resource.data.organizationId)))
        ) ||
        (
          request.method == 'delete' &&
          (!resource.data.keys().hasAll(['scope']) || resource.data.scope != 'global') &&
          hasPermission('studios_edit') &&
          (canAccessWorkspace(resource.data.workspaceIds) || (resource.data.keys().hasAll(['organizationId']) && isOrgMatch(resource.data.organizationId)))
        )
      );
    }

    match /automations/{aId} {
      // Allow read for all authorized users - workspace filtering happens in queries
      allow read: if isAuthorized();
      allow write: if isAuthorized() && (isSystemAdmin() || canAccessWorkspace(request.resource.data.workspaceIds));
    }

    // --- Operational Layer (Strict Workspace Confinement) ---
    match /tasks/{taskId} {
      allow get: if isAuthorized() && (
        isSystemAdmin() || 
        (getUserData() != null && resource.data.workspaceId in getUserData().get('workspaceIds', []))
      );
      allow list: if isAuthorized();
      allow write: if isAuthorized() && (
        isSystemAdmin() || 
        (getUserData() != null && resource.data.workspaceId in getUserData().get('workspaceIds', []))
      );
    }

    match /activities/{activityId} {
      allow get: if isAuthorized() && (
        isSystemAdmin() || 
        (getUserData() != null && resource.data.workspaceId in getUserData().get('workspaceIds', []))
      );
      allow list: if isAuthorized();
      allow create: if isAuthorized() || isSignedIn();
      allow update, delete: if isSignedIn() && request.auth.uid == resource.data.userId && resource.data.type == 'note';
    }

    match /message_logs/{logId} {
      allow get: if isAuthorized() && (isSystemAdmin() || canAccessWorkspace(resource.data.workspaceIds));
      allow list: if isAuthorized();
    }

    match /tracked_links/{linkId} {
      allow read: if isSignedIn();
      allow write: if false; // Server-only Admin SDK
    }

    // --- WhatsApp (Meta Cloud API) ---
    // Connections, sessions, and webhook idempotency markers hold encrypted
    // secrets and are written exclusively by the Admin SDK (server). Clients
    // read the redacted projection through authenticated Server Actions, never
    // the raw doc. Explicit deny is redundant with the default-deny at the top
    // but kept self-documenting.
    match /whatsapp_connections/{orgId} {
      allow read, write: if false;
    }
    match /whatsapp_sessions/{sessionId} {
      allow read, write: if false;
    }
    match /webhook_events/{eventId} {
      allow read, write: if false;
    }
    // Templates mirror Meta's registry; synced server-side (Admin SDK) only.
    // Org members may read their own org's templates for selection in the UI.
    match /whatsapp_templates/{templateId} {
      allow read: if isAuthorized() && (isSystemAdmin() || isOrgMatch(resource.data.organizationId));
      allow write: if false;
    }

    // --- Message Campaigns ---
    // Campaign management for bulk messaging
    match /message_campaigns/{campaignId} {
      // Read access: users in matching workspace
      allow get: if isAuthorized() && (
        isSystemAdmin() ||
        hasWorkspaceAccess(resource.data.workspaceId)
      );
      
      // List access: all authorized users (filtering by workspace happens in queries)
      allow list: if isAuthorized();
      
      // Create: users with workspace access
      allow create: if isAuthorized() && (
        isSystemAdmin() ||
        (hasWorkspaceAccess(request.resource.data.workspaceId) &&
         isOrgMatch(request.resource.data.organizationId))
      );
      
      // Update: users with workspace access
      // Prevent workspace and organization changes
      allow update: if isAuthorized() && (
        isSystemAdmin() ||
        (hasWorkspaceAccess(resource.data.workspaceId) &&
         isOrgMatch(resource.data.organizationId) &&
         request.resource.data.workspaceId == resource.data.workspaceId &&
         request.resource.data.organizationId == resource.data.organizationId)
      );
      
      // Delete: super admins or users with workspace access
      allow delete: if isAuthorized() && (
        isSystemAdmin() ||
        hasWorkspaceAccess(resource.data.workspaceId)
      );
    }

    // --- Message Audiences ---
    match /message_audiences/{audienceId} {
      allow read: if isSignedIn() && (request.auth.token.email == 'admin@smartsapp.com' || isAuthorized());
      allow write: if isSignedIn() && (request.auth.token.email == 'admin@smartsapp.com' || (isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId))));
    }

    // --- In-App Notifications ---
    // User-specific notifications displayed in the notification center
    match /in_app_notifications/{notificationId} {
      // Users can only read their own notifications
      allow get: if isSignedIn() && request.auth.uid == resource.data.userId;
      
      // List with userId filter
      allow list: if isSignedIn();
      
      // Users can mark their own notifications as read
      allow update: if isSignedIn() && 
                       request.auth.uid == resource.data.userId &&
                       request.resource.data.userId == resource.data.userId;
      
      // Only system can create notifications
      allow create: if isAuthorized();
      
      // Only system admin can delete
      allow delete: if isSystemAdmin();
    }

    // --- Entity Migration Security Rules (Requirement 29) ---
    
    /**
     * Enhanced security rules for feature collections using entityId
     * These rules enforce workspace boundaries and prevent cross-workspace data leakage
     * during and after the schoolId to entityId migration.
     */
    
    // Forms 2.0 collection
    match /forms/{formId} {
      allow get: if resource.data.status == 'published' || (
        isAuthorized() && (
          isSystemAdmin() ||
          hasWorkspaceAccess(resource.data.workspaceId)
        )
      );
      allow list: if isAuthorized() && (
        isSystemAdmin() ||
        hasPermission('studios_edit') ||
        hasWorkspaceAccess(resource.data.workspaceId)
      );
      allow create: if isAuthorized() && (
        isSystemAdmin() ||
        (hasPermission('studios_edit') && 
         hasWorkspaceAccess(request.resource.data.workspaceId))
      );
      allow update: if isAuthorized() && (
        isSystemAdmin() ||
        (hasPermission('studios_edit') && 
         hasWorkspaceAccess(resource.data.workspaceId) &&
         request.resource.data.workspaceId == resource.data.workspaceId)
      );
      allow delete: if isAuthorized() && (
        isSystemAdmin() ||
        (hasPermission('studios_edit') && 
         hasWorkspaceAccess(resource.data.workspaceId))
      );

      // Forms 2.0 version snapshots subcollection
      match /versions/{versionId} {
        allow read: if resource.data.status == 'published' || (
          isAuthorized() && (
            isSystemAdmin() ||
            hasWorkspaceAccess(get(/databases/$(database)/documents/forms/$(formId)).data.workspaceId)
          )
        );
        allow write: if isAuthorized() && (
          isSystemAdmin() ||
          hasPermission('studios_edit')
        );
      }

      // Forms 2.0 response intelligence & qualitative clusters subcollection (Phase 10)
      match /intelligence/{docId} {
        allow read: if isAuthorized() && (
          isSystemAdmin() ||
          hasWorkspaceAccess(get(/databases/$(database)/documents/forms/$(formId)).data.workspaceId)
        );
        allow write: if isAuthorized() && (
          isSystemAdmin() ||
          hasPermission('studios_edit')
        );
      }

      // Forms 2.0 custom generated reports subcollection (Phase 11)
      match /reports/{reportId} {
        allow read: if isAuthorized() && (
          isSystemAdmin() ||
          hasWorkspaceAccess(get(/databases/$(database)/documents/forms/$(formId)).data.workspaceId)
        );
        allow write: if isAuthorized() && (
          isSystemAdmin() ||
          hasPermission('studios_edit')
        );
      }

      // Forms 2.0 A/B Testing Experiments subcollection (Phase 12)
      match /experiments/{expId} {
        allow read: if isAuthorized() && (
          isSystemAdmin() ||
          hasWorkspaceAccess(get(/databases/$(database)/documents/forms/$(formId)).data.workspaceId)
        );
        allow write: if isAuthorized() && (
          isSystemAdmin() ||
          hasPermission('studios_edit')
        );
      }

      // Forms 2.0 Optimization Health Score & Diagnostics subcollection (Phase 12)
      match /optimization/{docId} {
        allow read: if isAuthorized() && (
          isSystemAdmin() ||
          hasWorkspaceAccess(get(/databases/$(database)/documents/forms/$(formId)).data.workspaceId)
        );
        allow write: if isAuthorized() && (
          isSystemAdmin() ||
          hasPermission('studios_edit')
        );
      }
    }

    // Forms 2.0 Scheduled Email Reports Collection (Phase 11)
    match /scheduled_reports/{configId} {
      allow read, write: if isAuthorized() && (
        isSystemAdmin() ||
        hasPermission('studios_edit')
      );
    }

    // Forms 2.0 Daily Analytics Rollup collection
    match /form_metrics_daily/{metricId} {
      allow read: if isAuthorized() && (
        isSystemAdmin() ||
        hasWorkspaceAccess(resource.data.workspaceId)
      );
      // Writes are strictly managed via Admin Server Actions with atomic increments
      allow write: if false;
    }

    // Forms 2.0 Ingested Sessions & Telemetry collection
    match /form_sessions/{sessionId} {
      allow read: if isAuthorized() && (
        isSystemAdmin() ||
        hasWorkspaceAccess(resource.data.workspaceId)
      );
      allow write: if false;
    }
    
    // Canonical Top-Level Form Submissions collection
    match /form_submissions/{submissionId} {
      allow read: if isAuthorized() && (
        isSystemAdmin() ||
        hasWorkspaceAccess(resource.data.workspaceId)
      );
      allow create: if true; // Public form submissions
      allow update, delete: if isAuthorized() && (
        isSystemAdmin() ||
        hasWorkspaceAccess(resource.data.workspaceId)
      );

      // Submission Internal Staff Notes
      match /notes/{noteId} {
        allow read, write: if isAuthorized();
      }
    }

    // Form Saved View Presets
    match /form_saved_views/{viewId} {
      allow read, write: if isAuthorized();
    }

    // Form Distribution Links & Campaigns
    match /form_distributions/{distId} {
      allow read, write: if isAuthorized();
    }

    match /form_events/{eventId} {
      allow read: if isAuthorized() && isSystemAdmin();
      allow create: if true; // Telemetry event emitter
    }

    // Form Drafts & Resume Later
    match /form_drafts/{draftId} {
      allow get, create, update: if true; // Public token-based draft resume
      allow delete: if isAuthorized();
    }
    
    // Automation logs - workspace boundary enforcement
    match /automation_logs/{logId} {
      // Unified read: allows both get and list without permission conflicts.
      allow read: if isAuthorized();
      allow create: if isAuthorized();
      allow update, delete: if isAuthorized() && isSystemAdmin();
    }
    
    // Entity audit logs - immutable audit trail
    match /entity_audit_logs/{logId} {
      // Unified read: allows both get and list without permission conflicts.
      allow read: if isAuthorized() && (isSystemAdmin() || hasPermission('activities_view'));
      allow create: if isSignedIn();
      allow update, delete: if false; // Immutable audit logs
    }
    // --- Import Logs & Data Ingestion ---
    match /import_logs/{logId} {
      allow get: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(resource.data.workspaceId)
      );
      allow list: if isAuthorized();
      allow create: if isAuthorized() && (
        isSystemAdmin() ||
        hasWorkspaceAccess(request.resource.data.workspaceId)
      );
      allow update: if isAuthorized() && (
        isSystemAdmin() ||
        hasWorkspaceAccess(resource.data.workspaceId)
      );
      allow delete: if isAuthorized() && isSystemAdmin();
    }

    match /import_logs/{logId}/failed_rows/{rowId} {
      allow read, write: if isAuthorized() && (
        isSystemAdmin() ||
        hasWorkspaceAccess(get(/databases/$(database)/documents/import_logs/$(logId)).data.workspaceId)
      );
    }

    // --- System / Analytics ---
    match /automation_runs/{runId} {
      allow read: if isAuthorized() && (
        isSystemAdmin() ||
        resource.data.workspaceId == null ||
        hasWorkspaceAccess(resource.data.workspaceId)
      );
    }
    match /automation_jobs/{jobId} {
      allow read: if isAuthorized() && (
        isSystemAdmin() ||
        resource.data.workspaceId == null ||
        hasWorkspaceAccess(resource.data.workspaceId)
      );
    }
    match /automation_message_event_executions/{execId} {
      allow read: if isAuthorized() && (
        isSystemAdmin() ||
        resource.data.workspaceId == null ||
        hasWorkspaceAccess(resource.data.workspaceId)
      );
      allow write: if isAuthorized();
    }
    match /survey_sessions/{sId} {
      allow create, update: if true;
      allow read, list: if isAuthorized();
    }
    match /campaign_sessions/{sId} {
      allow get, create, update: if true; // Public campaign visitor session
      allow list, delete: if isAuthorized() && isSystemAdmin();
    }

    // --- Scoring & Productivity Performance Engine ---
    match /userEffortSummary/{userId} {
      allow read: if isSignedIn();
      allow write: if isSystemAdmin();
    }

    match /effortRules/{ruleId} {
      allow read: if isSignedIn();
      allow write: if isSystemAdmin() || (isAuthorized() && hasWorkspaceAccess(resource.data.workspaceId));
    }

    match /leadScores/{contactId} {
      allow read: if isSignedIn() && (request.auth.token.email == 'admin@smartsapp.com' || isAuthorized());
      allow write: if false; // Server-side writes only
    }

    match /leadScoreHistory/{historyId} {
      allow read: if isSignedIn() && (request.auth.token.email == 'admin@smartsapp.com' || isAuthorized());
      allow write: if false; // Server-side writes only
    }

    match /effortScoringLedger/{ledgerId} {
      allow read: if isSignedIn() && (request.auth.token.email == 'admin@smartsapp.com' || isAuthorized());
      allow write: if false; // Server-side writes only
    }
    match /webhooks/{webhookId} {
      allow get: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(resource.data.workspaceId)
      );
      allow list: if isAuthorized();
      allow create: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(request.resource.data.workspaceId)
      );
      allow update: if isAuthorized() && (
        isSystemAdmin() || 
        (hasWorkspaceAccess(resource.data.workspaceId) && 
         request.resource.data.workspaceId == resource.data.workspaceId)
      );
      allow delete: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(resource.data.workspaceId)
      );
    }
    match /messaging_variables/{vId} {
      allow read, write: if isAuthorized();
    }

    // --- Custom Pages SEO ---
    match /custom_pages_seo/{pageId} {
      allow read: if true;
      allow write: if isAuthorized();
    }

    // --- {{Org_name}} Experience Platform — Portals ---
    match /portals/{portalId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();
    }

    // --- {{Org_name}} Experience Platform — Content Items & Revisions ---
    match /content_items/{itemId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();

      match /versions/{versionId} {
        allow read, write: if isAuthorized();
      }
    }

    // --- {{Org_name}} Experience Platform — Memberships & Directory ---
    match /portal_memberships/{membershipId} {
      allow get, list: if isSignedIn() || isAuthorized();
      allow create, update, delete: if isAuthorized();
    }

    // --- {{Org_name}} Experience Platform — Cryptographic Invitations ---
    match /portal_invitations/{invitationId} {
      allow get, list: if isSignedIn() || isAuthorized() || resource.data.status == 'pending';
      allow create, update, delete: if isAuthorized();
    }

    // --- {{Org_name}} Experience Platform — Membership Plans & Tiers ---
    match /membership_plans/{planId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();
    }

    // --- {{Org_name}} Experience Platform — Access Grants ---
    match /access_grants/{grantId} {
      allow get, list: if isSignedIn() || isAuthorized();
      allow create, update, delete: if isAuthorized();
    }

    // --- {{Org_name}} Experience Platform — Courses ---
    match /courses/{courseId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();
    }

    // --- {{Org_name}} Experience Platform — Course Modules ---
    match /course_modules/{moduleId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();
    }

    // --- {{Org_name}} Experience Platform — Course Lessons ---
    match /course_lessons/{lessonId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();
    }

    // --- {{Org_name}} Experience Platform — Course Enrollments ---
    match /course_enrollments/{enrollmentId} {
      allow get, list: if isSignedIn() || isAuthorized();
      allow create, update: if isSignedIn();
      allow delete: if isAuthorized();
    }

    // --- {{Org_name}} Experience Platform — Learning Progress ---
    match /learning_progress/{progressId} {
      allow get, list: if isSignedIn() || isAuthorized();
      allow create, update: if isSignedIn();
      allow delete: if isAuthorized();
    }

    // --- {{Org_name}} Experience Platform — Assessments & Assignments ---
    match /course_assessments/{assessmentId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();
    }

    match /course_assignments/{assignmentId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();
    }

    match /assignment_submissions/{submissionId} {
      allow get, list: if isSignedIn() || isAuthorized();
      allow create, update: if isSignedIn();
      allow delete: if isAuthorized();
    }

    // --- {{Org_name}} Experience Platform — Community Spaces ---
    match /community_spaces/{spaceId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();
    }

    // --- {{Org_name}} Experience Platform — Community Posts ---
    match /community_posts/{postId} {
      allow get, list: if true;
      allow create: if isSignedIn() || isAuthorized();
      allow update, delete: if isAuthorized() && (
        isSystemAdmin() ||
        resource.data.authorId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
    }

    // --- {{Org_name}} Experience Platform — Community Comments ---
    match /community_comments/{commentId} {
      allow get, list: if true;
      allow create: if isSignedIn() || isAuthorized();
      allow update, delete: if isAuthorized() && (
        isSystemAdmin() ||
        resource.data.authorId == request.auth.uid ||
        resource.data.userId == request.auth.uid
      );
    }

    // --- {{Org_name}} Experience Platform — Community Polls & Votes ---
    match /community_polls/{pollId} {
      allow get, list: if true;
      allow create: if isSignedIn() || isAuthorized();
      allow update, delete: if isAuthorized() && isSystemAdmin();
    }

    match /poll_votes/{voteId} {
      allow get, list: if true;
      allow create: if isSignedIn() || isAuthorized();
      allow update, delete: if isAuthorized() && (
        isSystemAdmin() ||
        resource.data.userId == request.auth.uid
      );
    }

    // --- {{Org_name}} Experience Platform — Community Reactions ---
    match /community_reactions/{reactionId} {
      allow get, list: if true;
      allow create: if isSignedIn() || isAuthorized();
      allow update, delete: if isAuthorized() && (
        isSystemAdmin() ||
        resource.data.userId == request.auth.uid
      );
    }

    // --- {{Org_name}} Experience Platform — Moderation Reports ---
    match /moderation_reports/{reportId} {
      allow get, list: if isSignedIn() || isAuthorized();
      allow create: if isSignedIn() || isAuthorized();
      allow update, delete: if isAuthorized();
    }

    // --- {{Org_name}} Experience Platform — Onboarding & Engagement Engine ---
    match /onboarding_flows/{flowId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();
    }

    match /portal_engagement_flows/{flowId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();
    }

    match /member_onboarding_progress/{progressId} {
      allow get, list: if isSignedIn() || isAuthorized();
      allow create: if isSignedIn() || isAuthorized();
      allow update, delete: if isAuthorized() && (
        isSystemAdmin() ||
        resource.data.userId == request.auth.uid
      );
    }

    match /member_tasks/{taskId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();
    }

    match /portal_engagement_tasks/{taskId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();
    }

    match /task_submissions/{submissionId} {
      allow get, list: if isSignedIn() || isAuthorized();
      allow create, update, delete: if isSignedIn() || isAuthorized();
    }

    match /portal_member_activities/{activityId} {
      allow get, list: if isSignedIn() || isAuthorized();
      allow create, update, delete: if isSignedIn() || isAuthorized();
    }

    match /member_engagement_profiles/{profileId} {
      allow get, list: if isSignedIn() || isAuthorized();
      allow create, update, delete: if isAuthorized();
    }

    // --- {{Org_name}} Experience Platform — Live Events, Cohorts & Replays ---
    match /live_events/{eventId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();
    }

    match /event_registrations/{registrationId} {
      allow get, list: if isSignedIn() || isAuthorized();
      allow create, update, delete: if isSignedIn() || isAuthorized();
    }

    match /course_cohorts/{cohortId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();
    }

    match /student_cohorts/{cohortId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();
    }

    // --- {{Org_name}} Experience Platform — Commerce, Offers & Affiliates ---
    match /portal_offers/{offerId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();
    }

    match /portal_coupons/{couponId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();
    }

    match /portal_orders/{orderId} {
      allow get, list: if isSignedIn() || isAuthorized();
      allow create, update, delete: if isSignedIn() || isAuthorized();
    }

    match /affiliate_partners/{partnerId} {
      allow get, list: if isSignedIn() || isAuthorized();
      allow create, update, delete: if isSignedIn() || isAuthorized();
    }

    match /affiliate_referrals/{referralId} {
      allow get, list: if isSignedIn() || isAuthorized();
      allow create, update, delete: if isAuthorized();
    }

    match /portal_waitlists/{waitlistId} {
      allow get, list, create, update, delete: if true;
    }

    // --- {{Org_name}} Experience Platform — AI Experience & Intelligence ---
    match /ai_generation_tasks/{taskId} {
      allow get, list, create, update, delete: if isAuthorized();
    }

    match /ai_tutor_sessions/{sessionId} {
      allow get, list, create, update, delete: if isSignedIn() || isAuthorized();
    }

    match /ai_knowledge_chunks/{chunkId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();
    }

    match /ai_pedagogy_diagnostics/{diagnosticId} {
      allow get, list, create, update, delete: if isAuthorized();
    }

    // --- {{Org_name}} Experience Platform — Analytics & Experience Intelligence ---
    match /portal_analytics_snapshots/{snapshotId} {
      allow get, list, create, update, delete: if isAuthorized();
    }

    // --- {{Org_name}} Experience Platform — Credentials & Learning Interoperability ---
    match /certificate_templates/{templateId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();
    }

    match /issued_certificates/{certId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();
    }

    match /badge_definitions/{badgeId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();
    }

    match /awarded_badges/{awardId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();
    }

    match /xapi_statements/{statementId} {
      allow get, list, create, update, delete: if isAuthorized();
    }

    // --- {{Org_name}} Experience Platform — Enterprise, Scale & Marketplace ---
    match /enterprise_sso_configs/{configId} {
      allow get, list, create, update, delete: if isAuthorized();
    }

    match /enterprise_whitelabel_configs/{configId} {
      allow get, list, create, update, delete: if isAuthorized();
    }

    match /organization_hierarchy/{nodeId} {
      allow get, list, create, update, delete: if isAuthorized();
    }

    match /marketplace_listings/{listingId} {
      allow get, list: if true;
      allow create, update, delete: if isAuthorized();
    }

    match /marketplace_installs/{installId} {
      allow get, list, create, update, delete: if isAuthorized();
    }

    match /enterprise_audit_logs/{logId} {
      allow get, list, create, update, delete: if isAuthorized();
    }
    match /enterprise_whitelabel_configs/{configId} {
      allow get, list: if true; // Public get for custom domain router resolution
      allow create, update, delete: if isAuthorized() && (isSystemAdmin() || hasPermission('studios_edit'));
    }

    match /org_hierarchy_nodes/{nodeId} {
      allow get, list: if isSignedIn() || isAuthorized();
      allow create, update, delete: if isAuthorized() && (isSystemAdmin() || hasPermission('studios_edit'));
    }

    match /marketplace_listings/{listingId} {
      allow get, list: if true; // Public marketplace browse
      allow create, update, delete: if isAuthorized() && isSystemAdmin();
    }

    match /enterprise_audit_logs/{logId} {
      allow get, list, create: if isAuthorized() && (isSystemAdmin() || isOrgMatch(resource.data.organizationId));
      allow update, delete: if isAuthorized() && isSystemAdmin();
    }

    // --- Landing Pages / Campaign Pages ---
    match /campaign_pages/{pageId} {
      allow get: if resource.data.status == 'published' || (isAuthorized() && (isSystemAdmin() || isOrgMatch(resource.data.organizationId)));
      allow list: if isAuthorized();
      allow write: if isAuthorized() && (isSystemAdmin() || hasPermission('studios_edit'));
    }

    match /campaign_page_versions/{vId} {
      allow get: if resource.data.isPublishedVersion == true || (isAuthorized() && (isSystemAdmin() || isOrgMatch(resource.data.organizationId)));
      allow list: if isAuthorized();
      allow write: if isAuthorized() && (isSystemAdmin() || hasPermission('studios_edit'));
    }

    match /ai_change_sets/{changeSetId} {
      allow get, list: if isAuthorized() && (isSystemAdmin() || isOrgMatch(resource.data.organizationId));
      allow write: if isAuthorized() && (isSystemAdmin() || (hasPermission('studios_edit') && isOrgMatch(request.resource.data.organizationId)));
    }

    match /audiences/{audienceId} {
      allow get: if true;
      allow list: if isAuthorized() && (isSystemAdmin() || isOrgMatch(resource.data.organizationId));
      allow write: if isAuthorized() && (isSystemAdmin() || (hasPermission('studios_edit') && isOrgMatch(request.resource.data.organizationId)));
    }

    match /experience_rules/{ruleId} {
      allow get: if true;
      allow list: if isAuthorized() || resource.data.isEnabled == true;
      allow write: if isAuthorized() && (isSystemAdmin() || (hasPermission('studios_edit') && isOrgMatch(request.resource.data.organizationId)));
    }

    match /experiments/{experimentId} {
      allow get: if true;
      allow list: if isAuthorized() && (isSystemAdmin() || isOrgMatch(resource.data.organizationId));
      allow write: if isAuthorized() && (isSystemAdmin() || (hasPermission('studios_edit') && isOrgMatch(request.resource.data.organizationId)));
    }

    match /page_insights/{insightId} {
      allow read: if isAuthorized() && (isSystemAdmin() || isOrgMatch(resource.data.organizationId));
      allow write: if isAuthorized() && (isSystemAdmin() || (hasPermission('studios_edit') && isOrgMatch(request.resource.data.organizationId)));
    }

    match /bandit_policies/{policyId} {
      allow get: if true;
      allow list: if isAuthorized() && (isSystemAdmin() || isOrgMatch(resource.data.organizationId));
      allow write: if isAuthorized() && (isSystemAdmin() || (hasPermission('studios_edit') && isOrgMatch(request.resource.data.organizationId)));
    }

    match /page_audit_logs/{logId} {
      allow read: if isAuthorized() && (isSystemAdmin() || isOrgMatch(resource.data.organizationId));
      allow create: if isAuthorized() && (isSystemAdmin() || isOrgMatch(request.resource.data.organizationId));
      allow update, delete: if false; // Immutable append-only audit trail
    }

    match /approval_requests/{requestId} {
      allow read: if isAuthorized() && (isSystemAdmin() || isOrgMatch(resource.data.organizationId));
      allow write: if isAuthorized() && (isSystemAdmin() || (hasPermission('studios_admin') && isOrgMatch(request.resource.data.organizationId)));
    }

    match /campaign_orchestrations/{orchestrationId} {
      allow read: if isAuthorized() && (isSystemAdmin() || isOrgMatch(resource.data.organizationId));
      allow write: if isAuthorized() && (isSystemAdmin() || (hasPermission('studios_edit') && isOrgMatch(request.resource.data.organizationId)));
    }

    match /custom_page_analytics/{pageId} {
      allow get: if isAuthorized();
      allow write: if false; // Server-only ingestion via Server Actions & Admin SDK
    }

    match /custom_page_events/{eventId} {
      allow read, write: if false; // Server-only ingestion via Server Actions & Admin SDK
    }

    match /page_templates/{tId} {
      allow read: if isAuthorized();
      allow write: if isAuthorized() && isSystemAdmin();
    }

    // --- Contracts ---
    match /contracts/{contractId} {
      allow get: if isAuthorized() && (isSystemAdmin() || canAccessWorkspace(resource.data.workspaceIds));
      allow list: if isAuthorized();
      allow write: if isAuthorized() && (isSystemAdmin() || (hasPermission('finance_manage') && canAccessWorkspace(request.resource.data.workspaceIds)));
    }

    // --- Perspectives ---
    match /perspectives/{pId} {
      allow read: if isAuthorized();
      allow write: if isAuthorized() && isSystemAdmin();
    }

    // --- Zones ---
    match /zones/{zoneId} {
      allow get: if isAuthorized() && (isSystemAdmin() || isOrgMatch(resource.data.organizationId));
      allow list: if isAuthorized();
      allow write: if isAuthorized() && (isSystemAdmin() || hasPermission('schools_edit'));
    }

    // --- PDF Sessions ---
    match /pdf_sessions/{sId} {
      allow read, write: if isAuthorized();
    }

    // --- Message Jobs ---
    match /message_jobs/{jobId} {
      allow get: if isAuthorized() && (isSystemAdmin() || canAccessWorkspace(resource.data.workspaceIds));
      allow list: if isAuthorized();
      allow write: if isAuthorized();
    }

    // --- Call Centre ---
    match /call_scripts/{scriptId} {
      allow get, list: if isSignedIn();
      allow write: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId) || (resource != null && hasWorkspaceAccess(resource.data.workspaceId)));
    }

    match /call_campaigns/{campaignId} {
      allow get, list: if isSignedIn();
      allow write: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId) || (resource != null && hasWorkspaceAccess(resource.data.workspaceId)));
    }

    match /call_queue_items/{queueItemId} {
      allow get, list: if isSignedIn();
      allow write: if isAuthorized() && (isSystemAdmin() || hasWorkspaceAccess(request.resource.data.workspaceId) || (resource != null && hasWorkspaceAccess(resource.data.workspaceId)));
    }

    // --- Attendees (top-level) ---
    match /attendees/{aId} {
      allow create: if true;
      allow read, list: if isAuthorized();
      allow update, delete: if isAuthorized() && isSystemAdmin();
    }

    // --- Audit Logs ---
    match /audit_logs/{logId} {
      allow read, list: if isAuthorized() && (isSystemAdmin() || hasPermission('activities_view'));
      allow create: if isSignedIn();
      allow update, delete: if false;
    }

    // --- Dashboard Layouts ---
    match /dashboardLayouts/{layoutId} {
      allow read: if isAuthorized();
      allow write: if isAuthorized() && (isSystemAdmin() || hasPermission('dashboard_manage'));
    }

    match /dashboards/{docId} {
      allow get: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(resource.data.workspaceId)
      );
      allow write: if isAuthorized() && (
        isSystemAdmin() || 
        hasWorkspaceAccess(request.resource.data.workspaceId)
      );
    }

    // --- App Fields / Variable Registry ---
    match /app_fields/{fieldId} {
      allow read: if true; // Public field schema registry required for client-facing form rendering
      allow create: if isSignedIn() && (request.auth.token.email == 'admin@smartsapp.com' || (isAuthorized() && (
        isSystemAdmin() ||
        (hasPermission('studios_edit') && hasWorkspaceAccess(request.resource.data.workspaceId))
      )));
      allow update: if isSignedIn() && (request.auth.token.email == 'admin@smartsapp.com' || (isAuthorized() && (
        isSystemAdmin() ||
        (hasPermission('studios_edit') && hasWorkspaceAccess(resource.data.workspaceId))
      )));
      allow delete: if isSignedIn() && (request.auth.token.email == 'admin@smartsapp.com' || (isAuthorized() && (
        isSystemAdmin() ||
        (hasPermission('studios_edit') && hasWorkspaceAccess(resource.data.workspaceId))
      )));
    }

    match /field_groups/{groupId} {
      allow get, list: if isSignedIn() && (request.auth.token.email == 'admin@smartsapp.com' || isAuthorized());
      allow create: if isAuthorized() && (
        isSystemAdmin() ||
        (hasPermission('studios_edit') && hasWorkspaceAccess(request.resource.data.workspaceId))
      );
      allow update: if isAuthorized() && (
        isSystemAdmin() ||
        (hasPermission('studios_edit') && hasWorkspaceAccess(resource.data.workspaceId))
      );
      allow delete: if isAuthorized() && (
        isSystemAdmin() ||
        (hasPermission('studios_edit') && hasWorkspaceAccess(resource.data.workspaceId))
      );
    }

    // --- Contact Tagging System ---
    match /tags/{tagId} {
      // Unified read: allows both get and list without permission conflicts.
      allow read: if isAuthorized();
      allow create: if isAuthorized() && (
        isSystemAdmin() ||
        (hasPermission('tags_manage') && hasWorkspaceAccess(request.resource.data.workspaceId))
      );
      allow update: if isAuthorized() && (
        isSystemAdmin() ||
        (hasPermission('tags_manage') &&
         hasWorkspaceAccess(resource.data.workspaceId) &&
         resource.data.get('isSystem', false) == false)
      );
      allow delete: if isAuthorized() && (
        isSystemAdmin() ||
        (hasPermission('tags_manage') &&
         hasWorkspaceAccess(resource.data.workspaceId) &&
         resource.data.get('isSystem', false) == false)
      );
    }

    match /tag_audit_logs/{logId} {
      // Unified read: allows both get and list without permission conflicts.
      allow read: if isAuthorized();
      allow create: if isSignedIn();
      allow update, delete: if false;
    }



    match /entities/{entityId} {
      // Admin bypass - check first to avoid expensive getUserData() calls
      allow read, write: if request.auth != null && request.auth.token.email == 'admin@smartsapp.com';
      
      allow get: if true;
      allow list: if isAuthorized();
      
      // Allow create if user has schools_edit permission
      allow create: if isSystemAdmin() ||
        (isAuthorized() &&
         hasPermission('schools_edit') && 
         isOrgMatch(request.resource.data.organizationId));
      
      // Allow update if user has schools_edit permission
      // Requirement 29.3: Verify user permissions for entity updates
      allow update: if isSystemAdmin() ||
        (isAuthorized() &&
         hasPermission('schools_edit') && 
         isOrgMatch(resource.data.organizationId) &&
         // Prevent organization change
         request.resource.data.organizationId == resource.data.organizationId);
      
      // Allow delete if user has system_admin permission
      allow delete: if isAuthorized() && isSystemAdmin();
    }

    match /entity_notes/{noteId} {
      // Unified read: allows both get and list without permission conflicts.
      allow read: if isAuthorized();
      allow create: if isAuthorized() && (
        isSystemAdmin() ||
        hasWorkspaceAccess(request.resource.data.workspaceId)
      );
      allow update: if isAuthorized() && (
        isSystemAdmin() ||
        (hasWorkspaceAccess(resource.data.workspaceId) &&
         request.resource.data.workspaceId == resource.data.workspaceId &&
         request.auth.uid == resource.data.createdBy)
      );
      allow delete: if isAuthorized() && (
        isSystemAdmin() ||
        (hasWorkspaceAccess(resource.data.workspaceId) &&
         request.auth.uid == resource.data.createdBy)
      );
    }

    // --- Quick Notes (Unified Notes Workspace) ---
    // Mirrors the proven entity_notes model: workspace-scoped, author-owned writes.
    match /quick_notes/{noteId} {
      allow read: if isAuthorized() && (
        isSystemAdmin() ||
        hasWorkspaceAccess(resource.data.workspaceId)
      );
      allow create: if isAuthorized() &&
        // Author cannot be forged — pins createdBy to the caller (integrity/audit).
        request.resource.data.createdBy == request.auth.uid && (
          isSystemAdmin() ||
          hasWorkspaceAccess(request.resource.data.workspaceId)
        );
      allow update: if isAuthorized() && (
        isSystemAdmin() ||
        (hasWorkspaceAccess(resource.data.workspaceId) &&
         request.resource.data.workspaceId == resource.data.workspaceId &&
         request.auth.uid == resource.data.createdBy)
      );
      allow delete: if isAuthorized() && (
        isSystemAdmin() ||
        (hasWorkspaceAccess(resource.data.workspaceId) &&
         request.auth.uid == resource.data.createdBy)
      );
    }

    match /quick_note_categories/{categoryId} {
      allow read: if isAuthorized() && (
        isSystemAdmin() ||
        hasWorkspaceAccess(resource.data.workspaceId)
      );
      allow create: if isAuthorized() && (
        isSystemAdmin() ||
        hasWorkspaceAccess(request.resource.data.workspaceId)
      );
      allow update: if isAuthorized() && (
        isSystemAdmin() ||
        (hasWorkspaceAccess(resource.data.workspaceId) &&
         request.resource.data.workspaceId == resource.data.workspaceId)
      );
      allow delete: if isAuthorized() && (
        isSystemAdmin() ||
        hasWorkspaceAccess(resource.data.workspaceId)
      );
    }

    // Denormalized read-model projection. Fully server-mediated: written by the
    // Admin SDK and read only via the semantic-search server action (also Admin
    // SDK). Clients never read it directly, so deny client access entirely to
    // avoid exposing cross-workspace denormalized note text.
    match /note_index/{rowId} {
      allow read, write: if false;
    }

    match /workspace_entities/{workspaceEntityId} {
      // Requirement 9.5: Immediately deny reads/writes when workspace access is revoked
      // Requirement 29.1: Enforce workspace boundaries for workspace_entities
      // Requirement 29.2: Verify user permissions for entity updates
      // Requirement 29.5: Prevent cross-workspace data leakage
      // 
      // CRITICAL: The user.workspaceIds array MUST be kept in sync with role-based access.
      // When a user is removed from a role OR a workspace is removed from a role's workspaceIds,
      // the user.workspaceIds array MUST be updated immediately to ensure security rules
      // deny access without delay.
      //
      // This denormalization is necessary because Firestore security rules cannot perform
      // complex queries to check role membership dynamically.
      
      // Unified read: allows both get and list without permission conflicts.
      // Application-layer queries already filter by workspaceId.
      // Special case: admin@smartsapp.com always has access
      allow read: if request.auth != null && request.auth.token.email == 'admin@smartsapp.com';
      allow read: if isAuthorized();
      allow get: if true;
      
      // Allow create if user has schools_edit permission and workspace access
      // Enforce ScopeGuard: entity.entityType must match workspace.contactScope
      allow create: if request.auth != null && request.auth.token.email == 'admin@smartsapp.com';
      allow create: if isSystemAdmin() ||
        (isAuthorized() &&
         hasPermission('schools_edit') &&
         hasWorkspaceAccess(request.resource.data.workspaceId) &&
         // ScopeGuard validation: entityType must match workspace contactScope
         request.resource.data.entityType == get(/databases/$(database)/documents/workspaces/$(request.resource.data.workspaceId)).data.contactScope);
      
      // Allow update if user has schools_edit permission and workspace access
      // Requirement 29.3: Verify user permissions for entity updates
      allow update: if request.auth != null && request.auth.token.email == 'admin@smartsapp.com';
      allow update: if isSystemAdmin() ||
        (isAuthorized() &&
         hasPermission('schools_edit') &&
         hasWorkspaceAccess(resource.data.workspaceId) &&
         // Ensure workspace access is not changed to a workspace user doesn't have access to
         // This prevents cross-workspace data leakage
         request.resource.data.workspaceId == resource.data.workspaceId &&
         hasWorkspaceAccess(request.resource.data.workspaceId));
      
      // Allow delete if user has schools_edit permission and workspace access
      allow delete: if request.auth != null && request.auth.token.email == 'admin@smartsapp.com';
      allow delete: if isSystemAdmin() ||
        (isAuthorized() &&
         hasPermission('schools_edit') &&
         hasWorkspaceAccess(resource.data.workspaceId));

      match /activities/{activityId} {
        allow read, list: if isAuthorized();
        allow write: if isAuthorized() || isSystemAdmin();
      }
    }

    match /contacts/{contactId} {
      allow read, list: if isAuthorized();
      allow write: if isAuthorized() || isSystemAdmin();

      match /activities/{activityId} {
        allow read, list: if isAuthorized();
        allow write: if isAuthorized() || isSystemAdmin();
      }
    }

    // Read-model projection of contacts (Phase 6). Flattened one-row-per-contact
    // view of workspace_entities.entityContacts, written ONLY by the server
    // (Admin SDK, which bypasses rules) so client writes are denied. Reads mirror
    // workspace_entities; application-layer queries already filter by workspaceId.
    match /workspace_contacts/{contactDocId} {
      allow read: if request.auth != null && request.auth.token.email == 'admin@smartsapp.com';
      allow read: if isAuthorized();
      allow write: if false;
    }

    match /workspace_users/{docId} {
      allow read, list: if isAuthorized();
      allow write: if isSystemAdmin();
    }

    match /meeting_registrants/{docId} {
      allow create: if true;
      allow read, list, update: if isAuthorized();
      allow delete: if isSystemAdmin();
    }

    // --- Industry-Specific Collections ---
    // Requirement 10.9: Validate collection access based on Workspace Industry_Vertical
    // Requirement 16.8: Gate read/write on hasWorkspaceAccess AND workspaceIndustryMatches
    
    // SaaS Industry Collections
    match /trials/{trialId} {
      allow get: if isAuthorized() && (
        isSystemAdmin() ||
        (hasWorkspaceAccess(resource.data.workspaceId) && 
         workspaceIndustryMatches(resource.data.workspaceId, 'SaaS'))
      );
      allow list: if isAuthorized();
      allow create: if isAuthorized() && (
        isSystemAdmin() ||
        (hasPermission('saas_trials_manage') &&
         hasWorkspaceAccess(request.resource.data.workspaceId) &&
         workspaceIndustryMatches(request.resource.data.workspaceId, 'SaaS'))
      );
      allow update: if isAuthorized() && (
        isSystemAdmin() ||
        (hasPermission('saas_trials_manage') &&
         hasWorkspaceAccess(resource.data.workspaceId) &&
         workspaceIndustryMatches(resource.data.workspaceId, 'SaaS') &&
         request.resource.data.workspaceId == resource.data.workspaceId)
      );
      allow delete: if isAuthorized() && isSystemAdmin();
    }

    match /onboarding/{onboardingId} {
      allow get: if isAuthorized() && (
        isSystemAdmin() ||
        (hasWorkspaceAccess(resource.data.workspaceId) && 
         workspaceIndustryMatches(resource.data.workspaceId, 'SaaS'))
      );
      allow list: if isAuthorized();
      allow create: if isAuthorized() && (
        isSystemAdmin() ||
        (hasWorkspaceAccess(request.resource.data.workspaceId) &&
         workspaceIndustryMatches(request.resource.data.workspaceId, 'SaaS'))
      );
      allow update: if isAuthorized() && (
        isSystemAdmin() ||
        (hasWorkspaceAccess(resource.data.workspaceId) &&
         workspaceIndustryMatches(resource.data.workspaceId, 'SaaS') &&
         request.resource.data.workspaceId == resource.data.workspaceId)
      );
      allow delete: if isAuthorized() && isSystemAdmin();
    }

    match /subscriptions/{subscriptionId} {
      allow get: if isAuthorized() && (
        isSystemAdmin() ||
        (hasWorkspaceAccess(resource.data.workspaceId) && 
         workspaceIndustryMatches(resource.data.workspaceId, 'SaaS'))
      );
      allow list: if isAuthorized();
      allow create: if isAuthorized() && (
        isSystemAdmin() ||
        (hasPermission('finance_manage') &&
         hasWorkspaceAccess(request.resource.data.workspaceId) &&
         workspaceIndustryMatches(request.resource.data.workspaceId, 'SaaS'))
      );
      allow update: if isAuthorized() && (
        isSystemAdmin() ||
        (hasPermission('finance_manage') &&
         hasWorkspaceAccess(resource.data.workspaceId) &&
         workspaceIndustryMatches(resource.data.workspaceId, 'SaaS') &&
         request.resource.data.workspaceId == resource.data.workspaceId)
      );
      allow delete: if isAuthorized() && isSystemAdmin();
    }

    match /supportTickets/{ticketId} {
      allow get: if isAuthorized() && (
        isSystemAdmin() ||
        (hasWorkspaceAccess(resource.data.workspaceId) && 
         workspaceIndustryMatches(resource.data.workspaceId, 'SaaS'))
      );
      allow list: if isAuthorized();
      allow create: if isAuthorized() && (
        isSystemAdmin() ||
        (hasWorkspaceAccess(request.resource.data.workspaceId) &&
         workspaceIndustryMatches(request.resource.data.workspaceId, 'SaaS'))
      );
      allow update: if isAuthorized() && (
        isSystemAdmin() ||
        (hasWorkspaceAccess(resource.data.workspaceId) &&
         workspaceIndustryMatches(resource.data.workspaceId, 'SaaS') &&
         request.resource.data.workspaceId == resource.data.workspaceId)
      );
      allow delete: if isAuthorized() && isSystemAdmin();
    }

    match /healthScores/{scoreId} {
      allow get: if isAuthorized() && (
        isSystemAdmin() ||
        (hasWorkspaceAccess(resource.data.workspaceId) && 
         workspaceIndustryMatches(resource.data.workspaceId, 'SaaS'))
      );
      allow list: if isAuthorized();
      allow create: if isAuthorized() && (
        isSystemAdmin() ||
        (hasWorkspaceAccess(request.resource.data.workspaceId) &&
         workspaceIndustryMatches(request.resource.data.workspaceId, 'SaaS'))
      );
      allow update: if isAuthorized() && (
        isSystemAdmin() ||
        (hasWorkspaceAccess(resource.data.workspaceId) &&
         workspaceIndustryMatches(resource.data.workspaceId, 'SaaS') &&
         request.resource.data.workspaceId == resource.data.workspaceId)
      );
      allow delete: if isAuthorized() && isSystemAdmin();
    }

    // School Enrollment Industry Collections
    match /applications/{applicationId} {
      allow get: if isAuthorized() && (
        isSystemAdmin() ||
        (hasWorkspaceAccess(resource.data.workspaceId) && 
         workspaceIndustryMatches(resource.data.workspaceId, 'SchoolEnrollment'))
      );
      allow list: if isAuthorized();
      allow create: if isAuthorized() && (
        isSystemAdmin() ||
        (hasPermission('schoolenrollment_admissions_manage') &&
         hasWorkspaceAccess(request.resource.data.workspaceId) &&
         workspaceIndustryMatches(request.resource.data.workspaceId, 'SchoolEnrollment'))
      );
      allow update: if isAuthorized() && (
        isSystemAdmin() ||
        (hasPermission('schoolenrollment_admissions_manage') &&
         hasWorkspaceAccess(resource.data.workspaceId) &&
         workspaceIndustryMatches(resource.data.workspaceId, 'SchoolEnrollment') &&
         request.resource.data.workspaceId == resource.data.workspaceId)
      );
      allow delete: if isAuthorized() && isSystemAdmin();
    }

    match /enrollments/{enrollmentId} {
      allow get: if isAuthorized() && (
        isSystemAdmin() ||
        (hasWorkspaceAccess(resource.data.workspaceId) && 
         workspaceIndustryMatches(resource.data.workspaceId, 'SchoolEnrollment'))
      );
      allow list: if isAuthorized();
      allow create: if isAuthorized() && (
        isSystemAdmin() ||
        (hasPermission('schoolenrollment_admissions_manage') &&
         hasWorkspaceAccess(request.resource.data.workspaceId) &&
